#!/usr/bin/env bash
# PreToolUse hook for Claude Code's Bash tool. Blocks the three git moves the
# global instructions forbid, however the prose was read.
#
# Reads the tool call as JSON on stdin. Exit 2 blocks the call and sends the
# message on stderr back to the model. GIT_GUARD=allow in front of a command
# lets it through once garyj has approved the move; the override is visible
# in the transcript.
set -euo pipefail

input=$(cat)
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
[ -n "$cmd" ] || exit 0
case "$cmd" in *GIT_GUARD=allow*) exit 0 ;; esac

deny() {
    echo "git-guard: $1. If garyj approved this, re-run with GIT_GUARD=allow in front of the command." >&2
    exit 2
}

case "$cmd" in *--no-verify*) deny "--no-verify skips the hooks; fix the tool that failed instead" ;; esac

# Fold "git -C dir push" into "git push" so one match covers both.
cmd=$(printf '%s' "$cmd" | sed -E 's/git[[:space:]]+-C[[:space:]]+[^[:space:]]+[[:space:]]+push/git push/g')
case "$cmd" in *"git push"*) ;; *) exit 0 ;; esac

rest=${cmd#*git push}
rest=${rest%%[';&|']*}
set -f
# shellcheck disable=SC2086
set -- $rest
set +f
args=()
for word in "$@"; do
    case "$word" in
        --force|-f|--mirror) deny "force-push rewrites published history; use --force-with-lease on a solo branch" ;;
        -*) ;;
        +*) deny "a + refspec is a force-push; use --force-with-lease on a solo branch" ;;
        *) args+=("$word") ;;
    esac
done

if [ "${#args[@]}" -ge 2 ]; then
    target=${args[1]#*:}
else
    target=$(git -C "${cwd:-.}" symbolic-ref --short HEAD 2>/dev/null || true)
fi
case "$target" in
    master|main) deny "pushing to $target needs garyj's go" ;;
esac
exit 0
