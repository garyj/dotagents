{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-file-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "agent-files" }],
  "secrets": { "required": ["FILE_HOST_TOKEN"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  }
}
